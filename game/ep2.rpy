label ep2_intro:
    # scene bg_river
    t "달빛강 공원까지 굴러왔네."
    t "도망쳐 온 건지 휘말린 건지 모르겠다."
    "하늘에서 투표권이 계속 쏟아지고 있다."
    "퍽."
    n "아야."
    t "종이 모서리에 맞았어."
    t "왜 이렇게 아프지."
    "그때 저 멀리서 소리가 들린다."
    aq "밀리고 있소! 퉁소 내구도가 한계야!"
    fw "방어선이 뚫린다고!!! 님프 순위가 실시간으로 바뀌고 있어!!"
    me "젠장… 숫자로는 못 이겨."
    t "저 사람들은 뭐지."
    t "온몸에 먼지를 뒤집어쓰고 있는데."
    "가까이 다가가자 상황이 보이기 시작한다."
    "다리 건너편에서 거대한 대포가 투표권 뭉치를 쏘아대고 있다."
    "그걸 막고 서 있는 세 명."
    t "저 대포에서 날아오는 게 다 투표권이야?"
    t "어쩐지 아프더라."
    jump ep2_choice

label ep2_choice:
    me "(주인공을 발견하고) 어이, 거기."
    me "멍청하게 서 있지 말고 같이 막아."
    n "저요?"
    me "아니면 누구."
    fw "어서 와!! 방어선 유지가 안 돼!!"
    t "처음 보는 사람한테 갑자기 같이 싸우자고."
    t "근데 저 투표권 대포 맞으면 진짜 아프긴 한데."
    menu:
        "알겠어요. 같이 막아볼게요.":
            $ meta_sense -= 10
            $ immersion += 10
            $ fame += 10
            n "알겠어요. 같이 막아볼게요."
            fw "그래!! 그 기세다!!"
            aq "(처음으로 주인공을 제대로 바라보며) …쓸 만하겠소."
            me "말은 잘 하는데 실제로도 잘 따라오는지 두고 봐야지."
            t "이미 반은 휘말린 것 같은데."
        "저쪽 스킨이 더 예쁜 것 같던데요, 솔직히.":
            $ meta_sense += 10
            $ immersion -= 10
            $ fame -= 10
            n "저쪽 스킨이 더 예쁜 것 같던데요, 솔직히."
            "0.5초의 침묵."
            aq "(천천히 고개를 돌리며) …지금 뭐라고 했소?"
            me "(주인공의 멱살을 잡으며) 취향은 나중에 말해."
            n "아 잠깐만요, 손 놔요."
            t "이 사람 눈빛이 심상치 않다."
        "저 최애들은 이미 다 님프 먹어서 사실 상관없거든요.":
            $ meta_sense += 5
            $ immersion -= 5
            $ fame += 5
            n "저 최애들은 이미 다 님프 먹어서 사실 상관없거든요."
            me "…그래."
            me "그럼 강제로라도 부려 먹어야겠네."
            n "그게 협박이잖아요."
            fw "맞아, 협박이야. 어서 와."
            t "말이 통하는 사람이 한 명도 없다."
    jump ep2_game


label ep2_game:
    "자의든 타의든 최전방에 서게 됐다."
    "다리 건너편에서 대포 장전 소리가 들려온다."
    aq "온다."
    fw "광클해!! 날아오는 투표권 다 쳐내야 해!!"
    me "손가락에 불 나도록."
    t "날아오는 투표권을 클릭으로 쳐낸다고?"
    t "장원에서 말 안 되는 게 없다는 게 이런 거구나."
    n "알겠어요, 해볼게요!!"

    $ mg_state = "countdown"
    $ mg_countdown = 3
    $ mg_count = 0
    $ mg_time_left = 5.0
    $ mg_result = False
    $ mg_start_time = 0.0

    call screen minigame_ep2

    hide screen minigame_ep2

    if mg_result:
        $ meta_sense -= 5
        $ immersion += 5
        $ fame += 15
        jump ep2_win
    else:
        $ meta_sense += 5
        $ immersion -= 5
        $ fame -= 5
        jump ep2_lose

label ep2_win:
    n "다 쳐냈어!!"
    fw "막아냈다!! 방어선 유지!!"
    aq "…대단한 손가락이군."
    me "(땀을 닦으며) 쓸 만하네."
    t "그게 최대치 칭찬인 것 같다."
    n "근데 손가락이 진짜 아프거든요."
    jump ep2_outro

label ep2_lose:
    n "으아악, 매크로 없이는 무리야!!"
    fw "방어선 돌파당했다!! 님프 순위가 뒤집히고 있어어억!!!"
    aq "(투표권에 파묻히며 침착하게) …일단 후퇴하시오."
    me "(팔을 잡아끌며) 빨리 튀어."
    n "같이 뛰어요!!"
    t "져도 같이 지는 거니까 괜찮은 건가."
    jump ep2_outro

label ep2_outro:
    "연기가 가라앉은 다리 위."
    "넷이 가쁜 숨을 고른다."
    n "헉… 헉…"
    t "투표 전쟁이 진짜 세계대전급이네."
    me "끝까지 같이 버텨줬네."
    me "어이, 이름이 뭐야."
    n "[player_name]이요."
    me "그래, [player_name]. 나쁘지 않았어."
    t "저 사람한테 칭찬받을 줄은 몰랐는데."
    n "근데 그것보다요."
    n "저 여기서 탈출해서 현실로 돌아가야 하거든요. 방법 아는 분 없어요?"
    fw "탈출이요?"
    fw "마침 지금 성심병원에서 공식 게임이 열리는데."
    fw "거기서 이기면 현실로 돌아갈 수 있을지도 모른다고요!!"
    t "…그게 진짜일까."
    aq "장원 공식 게임이오. 속는 셈 치고 참가해보는 건 어떻소?"
    menu:
        "좋아요. 가볼게요.":
            n "좋아요. 가볼게요."
            t "어차피 다른 선택지도 없고."
        "혹시 거기서 져도 괜찮은 건가요?":
            n "혹시 거기서 져도 괜찮은 건가요?"
            fw "그건… 모르겠는데요?"
            me "걱정하지 마. 어차피 가는 거잖아."
            t "대답이 더 불안한데."
    "생존자들이 성심병원 입장 문 쪽으로 등을 떠밀기 시작한다."
    t "이 사람들 나를 좀 많이 떠미는 것 같은데."
    n "알겠어요, 알겠다고요!!"
    scene black
    centered "EP3. 감시자의 인권"
    jump ep3_intro